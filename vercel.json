{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "git": {
    "deploymentEnabled": true
  },
  "redirects": [
    {
      "source": "/mortgage-calculator",
      "destination": "/calculators/repayment",
      "permanent": true
    },
    {
      "source": "/mortgage-calculator/:slug",
      "destination": "/calculators/repayment/:slug",
      "permanent": true
    },
    {
      "source": "/repayment-calculator",
      "destination": "/calculators/repayment",
      "permanent": true
    },
    {
      "source": "/stamp-duty-calculator",
      "destination": "/calculators/stamp-duty",
      "permanent": true
    },
    {
      "source": "/affordability-calculator",
      "destination": "/calculators/affordability",
      "permanent": true
    },
    {
      "source": "/overpayment-calculator",
      "destination": "/calculators/overpayment",
      "permanent": true
    },
    {
      "source": "/max-borrowing",
      "destination": "/calculators/max-borrowing",
      "permanent": true
    },
    {
      "source": "/calculators",
      "destination": "/calculators/repayment",
      "permanent": false
    },
    {
      "source": "/guide/:slug",
      "destination": "/guides/:slug",
      "permanent": true
    },
    {
      "source": "/guides/overpayment",
      "destination": "/guides/mortgage-overpayment-guide",
      "permanent": true
    },
    {
      "source": "/guides/help-to-buy",
      "destination": "/guides/help-to-buy-repayment",
      "permanent": true
    },
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "www.repaywise.co.uk"
        }
      ],
      "destination": "https://repaywise.co.uk/robots.txt",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.repaywise.info"
        }
      ],
      "destination": "https://repaywise.co.uk/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "repaywise.info"
        }
      ],
      "destination": "https://repaywise.co.uk/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.repaywise.store"
        }
      ],
      "destination": "https://repaywise.co.uk/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "repaywise.store"
        }
      ],
      "destination": "https://repaywise.co.uk/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.repaywise.uk"
        }
      ],
      "destination": "https://repaywise.co.uk/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "repaywise.uk"
        }
      ],
      "destination": "https://repaywise.co.uk/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "uk-mortgage.vercel.app"
        }
      ],
      "destination": "https://repaywise.co.uk/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.repaywise.co.uk"
        }
      ],
      "destination": "https://repaywise.co.uk/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}