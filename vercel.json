{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/uk/bath",
      "destination": "/uk/bath-city",
      "statusCode": 301
    },
    {
      "source": "/uk/cambridge",
      "destination": "/uk/cambridge-city",
      "statusCode": 301
    },
    {
      "source": "/uk/nottingham",
      "destination": "/uk/nottingham-city",
      "statusCode": 301
    },
    {
      "source": "/uk/newcastle",
      "destination": "/uk/newcastle-city",
      "statusCode": 301
    },
    {
      "source": "/uk/leeds",
      "destination": "/uk/leeds-city",
      "statusCode": 301
    },
    {
      "source": "/calculators/maximum-mortgage-borrowing-calculator",
      "destination": "/calculators/max-borrowing",
      "statusCode": 301
    },
    {
      "source": "/calculators/mortgage-overpayment-calculator",
      "destination": "/calculators/overpayment",
      "statusCode": 301
    },
    {
      "source": "/calculators/mortgage-repayment-calculator",
      "destination": "/calculators/repayment",
      "statusCode": 301
    },
    {
      "source": "/uk/hull",
      "destination": "/uk/leeds-city",
      "statusCode": 301
    },
    {
      "source": "/uk/ipswich",
      "destination": "/uk/norwich",
      "statusCode": 301
    },
    {
      "source": "/uk/newport",
      "destination": "/uk/cardiff",
      "statusCode": 301
    },
    {
      "source": "/uk/gloucester",
      "destination": "/uk/cheltenham",
      "statusCode": 301
    },
    {
      "source": "/uk/worcester",
      "destination": "/uk/birmingham",
      "statusCode": 301
    },
    {
      "source": "/uk/inverness",
      "destination": "/uk/aberdeen",
      "statusCode": 301
    },
    {
      "source": "/uk/wrexham",
      "destination": "/uk/swansea",
      "statusCode": 301
    },
    {
      "source": "/calculators/home-equity-calculator",
      "destination": "/calculators/equity",
      "statusCode": 301
    },
    {
      "source": "/calculators/mortgage-affordability-calculator",
      "destination": "/calculators/affordability",
      "statusCode": 301
    },
    {
      "source": "/uk/coventry",
      "destination": "/uk/birmingham",
      "statusCode": 301
    },
    {
      "source": "/uk/stoke-on-trent",
      "destination": "/uk/stoke",
      "statusCode": 301
    },
    {
      "source": "/uk/londonderry",
      "destination": "/uk/belfast",
      "statusCode": 301
    },
    {
      "source": "/uk/middlesbrough",
      "destination": "/uk/newcastle-city",
      "statusCode": 301
    },
    {
      "source": "/uk/stirling",
      "destination": "/uk/edinburgh",
      "statusCode": 301
    },
    {
      "source": "/uk/warwick",
      "destination": "/uk/birmingham",
      "statusCode": 301
    },
    {
      "source": "/https://repaywise.co.uk/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/https:/repaywise.co.uk/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [],
  "git": {
    "deploymentEnabled": true
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.mjs",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/css; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    }
  ],
  "trailingSlash": false
}
